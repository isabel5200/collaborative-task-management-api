NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=collaborative_task_manager
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

NOTIFY_URL=http://127.0.0.1:4000/webhooks/tasks
NOTIFY_TIMEOUT_MS=3000
NOTIFY_RETRY_BASE_MS=250

CORS_ORIGIN=*

# Used only by the automated test suite. The suffix is a safety requirement.
TEST_DB_NAME=collaborative_task_manager_test
